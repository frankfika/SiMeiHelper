/* cup-grid — 打卡格子（03-VISUAL §4.5）
   只用 CSS 变量；.num 为组件内自绘等宽数字（样式隔离拿不到全局类） */
.cup-wrap {
  display: block;
}
.cup-rows {
  transform: scale(1);
}
/* 跨过目标瞬间：scale(1.04) 回弹 200ms */
.cup-pop {
  animation: cupPop 200ms ease-out;
}
@keyframes cupPop {
  0% { transform: scale(1); }
  50% { transform: scale(1.04); }
  100% { transform: scale(1); }
}
.cup-row {
  display: flex;
}
/* 格子 64×64rpx，r-sm，间距 12rpx */
.cup-cell {
  box-sizing: border-box;
  width: 64rpx;
  height: 64rpx;
  margin: 0 12rpx 12rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-sm);
  background: var(--c-surface-2);
  transition: transform 100ms ease-out;
}
.cup-press {
  transform: scale(0.92);
}
.cup-icon {
  font-size: 28rpx;
  line-height: 1;
}
/* 空格：surface-2 底，emoji 25% 透明 */
.cup-empty .cup-icon {
  opacity: 0.25;
}
/* 已填：primary-soft 底 + 2rpx primary 描边，emoji 不透明 */
.cup-full {
  background: var(--c-primary-soft);
  border: 2rpx solid var(--c-primary);
}
/* 半格：左半 primary-soft、右半 surface-2 */
.cup-half {
  background: linear-gradient(90deg, var(--c-primary-soft) 50%, var(--c-surface-2) 50%);
}
/* 「+」格：虚线边框（value ≥ target 后出现在末尾） */
.cup-plus {
  background: transparent;
  border: 2rpx dashed var(--c-border);
}
.cup-plus-sign {
  font-size: 32rpx;
  line-height: 1;
  color: var(--c-text-3);
}
/* 计数行「{value}/{target} 份|杯」：等宽数字 */
.cup-count {
  margin-top: 4rpx;
  font-size: var(--fs-body-sm);
  line-height: 1.5;
  color: var(--c-text-3);
}
.num {
  font-variant-numeric: tabular-nums;
  font-family: "DIN Alternate", -apple-system, "Helvetica Neue", sans-serif;
}
/* 达标：success 色 + ✓ */
.cup-reached {
  color: var(--c-success);
}
