/* line-chart — 体重趋势折线图（03-VISUAL §4.7）
   只用 CSS 变量，不写死色值；tooltip 用 WXML 浮层（shadow-float + r-sm） */
.lc-wrap {
  position: relative;
  width: 100%;
}
.lc-canvas {
  display: block;
  width: 100%;
  height: 100%;
}
/* 空数据：居中灰字 */
.lc-empty {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  color: var(--c-text-3);
}
/* 点按 tooltip：「10/5 · 88.4kg」，锚点在点的正上方 */
.lc-tip {
  position: absolute;
  transform: translate(-50%, calc(-100% - 10px));
  padding: 8rpx 16rpx;
  background: var(--c-surface);
  border: var(--border-card);
  border-radius: var(--r-sm);
  box-shadow: var(--shadow-float);
  font-size: var(--fs-caption);
  line-height: 1.4;
  color: var(--c-text-1);
  white-space: nowrap;
}
