/* ring — 进度环（03-VISUAL §4.6）
   注意：样式隔离拿不到全局类，.num 等全部自绘；wxss 只用 CSS 变量 */
.ring-wrap {
  position: relative;
  display: inline-flex;
}
.ring-canvas {
  display: block;
  width: 100%;
  height: 100%;
}
/* 中心文字覆盖层 */
.ring-center {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
.ring-num-row {
  display: flex;
  align-items: baseline;
}
/* 等价全局 .num（等宽数字）：组件内自绘 */
.num {
  font-variant-numeric: tabular-nums;
  font-family: "DIN Alternate", -apple-system, "Helvetica Neue", sans-serif;
}
.ring-num {
  font-weight: 600;
  line-height: 1.1;
  color: var(--c-text-1);
}
.ring-unit {
  margin-left: 2rpx;
  font-size: var(--fs-caption);
  color: var(--c-text-2);
}
.ring-label {
  margin-top: 4rpx;
  font-size: var(--fs-caption);
  line-height: 1.4;
  color: var(--c-text-3);
}
