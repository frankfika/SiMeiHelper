/* 自定义底部 Tab（docs/03-VISUAL.md §4.10）
   颜色全部引用 page 上的 CSS 变量（app.wxss §3.8），暗色模式自动生效；
   容器高 100rpx + 安全区，surface 底，顶部 1rpx 描边，4 等分，无切换动画 */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  box-sizing: border-box;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--c-surface);
  border-top: 1rpx solid var(--c-border);
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
/* 图标区固定 64rpx 高，保证普通 tab 与「小美」圆底两种形态纵向对齐 */
.tab-icon-wrap {
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tab-icon {
  font-size: 40rpx;
  line-height: 1;
  filter: grayscale(1);
  opacity: .55;
}
.tab-icon-on {
  filter: none;
  opacity: 1;
}
/* 「小美」项：emoji 置于 64rpx accent 圆内；未选中圆底 accent-soft，
   emoji 不灰化、不降透明，保持"有生命"（§4.10） */
.tab-icon-ai {
  width: 64rpx;
  border-radius: 50%;
  background: var(--c-accent-soft);
}
.tab-icon-ai .tab-icon {
  font-size: 36rpx;
  filter: none;
  opacity: 1;
}
.tab-icon-ai-on {
  background: var(--c-accent);
}
/* 文字：caption，选中加 500 字重 */
.tab-text {
  margin-top: 4rpx;
  font-size: var(--fs-caption);
  line-height: 32rpx;
  color: var(--c-text-3);
}
.tab-text-on {
  color: var(--c-primary);
  font-weight: 500;
}
.tab-text-ai-on {
  color: var(--c-accent-text);
  font-weight: 500;
}
