/* pages/today — 页面私有布局（颜色一律 var(--c-*)，全局类不重定义） */

/* ---- 难受模式顶部条（§6.2） ---- */
.bad-banner {
  margin-bottom: var(--sp-3);
}
.bad-banner-text {
  flex: 1;
  min-width: 0;
}
.bad-banner-actions {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  flex-shrink: 0;
}
.bad-banner-link {
  font-size: var(--fs-body-sm);
  font-weight: 500;
  color: var(--c-warning-text);
}

/* ---- ① 问候行 ---- */
.hello {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: var(--sp-4);
}
.hello-greet {
  font-size: var(--fs-h1);
  font-weight: 600;
  line-height: 1.3;
  color: var(--c-text-1);
}
.hello-date {
  margin-top: var(--sp-1);
  font-size: var(--fs-caption);
  color: var(--c-text-3);
}
.hello .pill {
  margin-top: 6rpx;
  flex-shrink: 0;
}

/* ---- ② 简报卡 ---- */
.brief-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
/* card-ai 内的 card-label 自带 ✨ 前缀与 accent 色（app.wxss），此处只调布局 */
.brief-head .card-label {
  margin-bottom: 0;
}
.brief-source {
  font-size: var(--fs-caption);
  color: var(--c-text-3);
}
.brief-thinking {
  display: flex;
  align-items: center;
}
.brief-thinking-text {
  margin-left: var(--sp-1);
  font-size: var(--fs-caption);
  color: var(--c-text-3);
}
.brief-body {
  margin-top: var(--sp-3);
}
.brief-flash {
  animation: today-brief-in 200ms ease-out both;
}
@keyframes today-brief-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
.brief-headline {
  font-size: var(--fs-h2);
  font-weight: 600;
  line-height: 1.4;
  color: var(--c-text-1);
}
.brief-tasks {
  margin-top: var(--sp-2);
}
.brief-task {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  border-bottom: 1rpx solid var(--c-border);
}
.brief-task:last-child {
  border-bottom: none;
}
.brief-task-circle {
  width: 36rpx;
  height: 36rpx;
  margin-right: var(--sp-2);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--c-primary);
  border-radius: 50%;
  font-size: 24rpx;
  color: var(--c-on-primary);
  flex-shrink: 0;
}
.brief-task-done {
  background: var(--c-primary);
}
.brief-task-text {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  color: var(--c-text-1);
}
.brief-task-text-done {
  text-decoration: line-through;
  color: var(--c-text-3);
}
.brief-task-progress {
  margin-left: var(--sp-2);
  font-size: var(--fs-body-sm);
  color: var(--c-text-3);
  flex-shrink: 0;
}
.brief-note {
  margin-top: var(--sp-2);
  font-size: var(--fs-caption);
  color: var(--c-text-3);
}
.brief-ask-row {
  display: flex;
  justify-content: flex-end;
  margin-top: var(--sp-1);
}

/* ---- ③ 药物状态卡 ---- */
.med-card {
  transition: border-color 600ms ease-out;
}
.med-highlight {
  border-color: var(--c-primary);
}
.med-main {
  display: flex;
  align-items: center;
}
.med-ring {
  width: 160rpx;
  flex-shrink: 0;
}
.med-info {
  flex: 1;
  min-width: 0;
  margin-left: var(--sp-4);
}
.med-title {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--c-text-1);
}
.med-phase {
  margin-top: var(--sp-2);
  display: flex;
  align-items: flex-start;
}
.med-phase-pill {
  flex-shrink: 0;
  margin-right: var(--sp-2);
}
.med-hint {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body-sm);
  line-height: 1.5;
  color: var(--c-text-2);
}
.med-hint-empty {
  margin-top: var(--sp-2);
}
.med-next {
  margin-top: var(--sp-2);
  font-size: var(--fs-body-sm);
  color: var(--c-text-1);
}
.med-next-today {
  color: var(--c-primary);
  font-weight: 500;
}
.med-next-warn {
  color: var(--c-warning);
  font-weight: 500;
}
.med-switch-note {
  margin-top: var(--sp-1);
  font-size: var(--fs-caption);
  color: var(--c-text-3);
}
.med-btn {
  margin-top: var(--sp-3);
}
.med-link {
  display: flex;
  justify-content: flex-end;
  margin-top: var(--sp-1);
}
.med-foot {
  margin-top: var(--sp-2);
  font-size: var(--fs-caption);
  color: var(--c-text-3);
}

/* explore / prescribed 清单 */
.ck-item {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  border-bottom: 1rpx solid var(--c-border);
}
.ck-item:last-of-type {
  border-bottom: none;
}
.ck-circle {
  width: 36rpx;
  height: 36rpx;
  margin-right: var(--sp-2);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--c-primary);
  border-radius: 50%;
  font-size: 24rpx;
  color: var(--c-on-primary);
  flex-shrink: 0;
}
.ck-done {
  background: var(--c-primary);
}
.ck-text {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  color: var(--c-text-1);
}

/* maintain 守护区间 */
.maintain-current {
  font-size: var(--fs-body-sm);
  color: var(--c-text-2);
  margin-bottom: var(--sp-2);
}
.maintain-bar {
  margin: var(--sp-3) 0;
}
.maintain-text {
  font-size: var(--fs-body-sm);
  color: var(--c-text-1);
}

/* ---- ⑤ 体重小卡 ---- */
.weight-card {
  display: flex;
  align-items: center;
}
.weight-left {
  flex: 1;
  min-width: 0;
}
.weight-num {
  display: flex;
  align-items: baseline;
}
.weight-big {
  font-size: var(--fs-display);
  font-weight: 600;
  line-height: 1.1;
  color: var(--c-text-1);
}
.weight-unit {
  margin-left: var(--sp-1);
  font-size: var(--fs-body-sm);
  color: var(--c-text-3);
}
.weight-change {
  margin-top: var(--sp-1);
  font-size: var(--fs-caption);
  color: var(--c-text-2);
}
.weight-right {
  width: 280rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.weight-hint {
  font-size: var(--fs-caption);
  color: var(--c-text-3);
  margin-bottom: var(--sp-1);
}
.weight-chart {
  width: 100%;
}

/* ---- ⑥ 阶段指南卡 ---- */
.guide-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.guide-title {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--c-text-1);
}
.guide-extra {
  margin-left: var(--sp-2);
  font-size: var(--fs-caption);
  color: var(--c-text-3);
  flex-shrink: 0;
}

/* ---- ⑦ 页脚 ---- */
.today-foot {
  padding: var(--sp-4) 0;
  text-align: center;
  font-size: var(--fs-caption);
  color: var(--c-text-3);
}
